{
	"cli": {
		"version": ">= 10.0.0",
		"appVersionSource": "local"
	},
	"build": {
		"production": {
			"node": "22.14.0",
			"pnpm": "10.10.0",
			"environment": "production",
			"distribution": "internal",
			"android": {
				"image": "latest",
				"withoutCredentials": true,
				"resourceClass": "large",
				"buildType": "apk"
			},
			"ios": {
				"image": "latest",
				"simulator": true,
				"env": {
					"EXPO_NO_CAPABILITY_SYNC": "1"
				}
			}
		}
	}
}
